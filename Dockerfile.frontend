# Separate static images; build with --target web or --target admin.
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY apps ./apps
COPY packages ./packages
COPY scripts/build-frontends.mjs ./scripts/build-frontends.mjs
COPY static ./static
RUN node scripts/build-frontends.mjs

FROM nginx:stable-alpine AS runtime
ARG SOURCE_REVISION=unknown
ARG SOURCE_REPOSITORY=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REVISION \
      org.opencontainers.image.source=$SOURCE_REPOSITORY
RUN sed -i 's@/var/run/nginx.pid@/tmp/nginx.pid@' /etc/nginx/nginx.conf \
    && mkdir -p /etc/nginx/templates \
    && chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html /etc/nginx/templates
COPY deploy/frontend/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 deploy/frontend/40-onstage-config.sh /docker-entrypoint.d/40-onstage-config.sh
ENV ONSTAGE_API_ORIGIN="" ONSTAGE_WS_ORIGIN="" NGINX_ENVSUBST_FILTER="^ONSTAGE_"
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

FROM runtime AS web
COPY --from=build --chown=nginx:nginx /src/build/web /usr/share/nginx/html

FROM runtime AS admin
COPY --from=build --chown=nginx:nginx /src/build/admin /usr/share/nginx/html
