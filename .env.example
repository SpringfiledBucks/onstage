# Production template. Visitors have only low-risk public read access.
# Never commit an actual session, cookie or server credential.
ONSTAGE_DATA_DIR=/var/lib/onstage
ONSTAGE_PUBLIC_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
ONSTAGE_SECURE_COOKIE=1
ONSTAGE_VERSION=0.9.0
ONSTAGE_FRONTEND_ORIGINS=https://REPLACE_WITH_TRUSTED_WEB_DOMAIN
ONSTAGE_ADMIN_ORIGINS=https://REPLACE_WITH_TRUSTED_ADMIN_DOMAIN
# Do not add *.neboer.site to these credentialed allowlists.
# Public read endpoints separately allow valid HTTPS subdomains of neboer.site.
# ONSTAGE_METRICS_TOKEN=inject-through-secret-store
# Explicit old-version compatibility only; keep disabled for the account service.
ONSTAGE_LEGACY_GUESTS=0

# Self-hosted production: independent PostgreSQL, provision through a secret store.
# Never paste a real password here. PostgreSQL startup checks schema only; run
# python tools/database.py migrate as a separate controlled release step.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/onstage?sslmode=require
# Required for development and production. Missing/SQLite URLs fail explicitly;
# existing SQLite files are retired, preserved unopened, and not imported.

# Sites-only operator key: configure as a secret through Sites Settings/tools.
# Do not place its real value here, in browser code, or in a command-line flag.
# ONSTAGE_OPERATOR_TOKEN=

# Small single-process demo limits. Restoring a valid cookie does not create a session.
ONSTAGE_SESSION_TTL_SECONDS=604800
ONSTAGE_SESSION_LIMIT_PER_MINUTE=60
ONSTAGE_SESSION_LIMIT_PER_HOUR=300
ONSTAGE_MAX_ACTIVE_SESSIONS=500
ONSTAGE_ROOM_LIMIT_PER_HOUR=4
ONSTAGE_ROOM_IP_LIMIT_PER_HOUR=20
ONSTAGE_MAX_ACTIVE_ROOMS=10
ONSTAGE_MAX_ACTIVE_ROOMS_PER_SESSION=2
ONSTAGE_MAX_ROOM_MEMBERS=30
ONSTAGE_MAX_ROOM_IDENTITIES=150
ONSTAGE_REPORT_LIMIT_PER_HOUR=5
ONSTAGE_MESSAGE_LIMIT_PER_MINUTE=60

# Freeze business writes before final migration export; controlled restart/redeploy required.
ONSTAGE_WRITE_FROZEN=0

# Optional Web Push: mount a persistent P-256 PEM Secret; never put key bytes here.
# No key configured => notification UI reports unavailable, chat still works.
# ONSTAGE_VAPID_PRIVATE_KEY_FILE=/run/secrets/onstage-vapid-private.pem
# ONSTAGE_VAPID_SUBJECT=mailto:YOUR_OPERATOR_CONTACT
# Optional additional exact trusted push-provider hosts (no URLs/wildcards).
# ONSTAGE_PUSH_PROVIDER_HOSTS=
